# Clé API Anthropic — bornes générées par IA + dialogues libres avec les PNJ
ANTHROPIC_API_KEY=sk-ant-...
# Plafond de répliques de PNJ par jour, tous joueurs confondus (coût maîtrisé)
NPC_DAILY_CAP=3000
# Modèles (facultatif) : AI_MODEL_BORNES=claude-sonnet-5-5, AI_MODEL_PNJ=claude-haiku-5-5

# Voix des PNJ (Piper, installé tout seul dans server/data/piper) : 0 = ne pas installer
PIPER_AUTO_INSTALL=1

# Micro des PNJ (whisper.cpp compilé dans server/data/whisper, il faut
# build-essential cmake git) : 0 = ne pas installer. Modèle : tiny, base,
# small-q5_1 (défaut, bon en français), medium-q5_0 (gros CPU)
WHISPER_AUTO_INSTALL=1
WHISPER_MODEL=small-q5_1

# Clé secrète du mode admin (gestion des tags en jeu, touche P)
ADMIN_KEY=change-moi

# Port du serveur (par défaut 3000)
PORT=3000
